{{ 'shopx-category-tiles.css' | asset_url | stylesheet_tag }}

<div
  class="shopx-category-tiles"
  style="
    --shopx-category-tiles-background: {{ section.settings.background_color }};
    --shopx-category-tiles-title-color: {{ section.settings.title_color }};
    --shopx-category-tiles-padding-top: {{ section.settings.padding_top }}px;
    --shopx-category-tiles-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <ul class="shopx-category-tiles__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = block.settings.collection
        assign tile_image = block.settings.image | default: tile_collection.featured_image
        assign tile_title = block.settings.title | default: tile_collection.title
        assign tile_link = block.settings.link | default: tile_collection.url
      -%}
      <li class="shopx-category-tiles__item" {{ block.shopify_attributes }}>
        {%- if tile_link != blank -%}
          <a class="shopx-category-tiles__link" href="{{ tile_link }}">
        {%- else -%}
          <div class="shopx-category-tiles__link">
        {%- endif -%}

        <div class="shopx-category-tiles__media">
          {%- if tile_image != blank -%}
            {%- assign tile_alt = tile_image.alt | default: tile_title -%}
            {{
              tile_image
              | image_url: width: 1200
              | image_tag:
                class: 'shopx-category-tiles__image',
                widths: '300, 450, 600, 900, 1200',
                sizes: '(min-width: 750px) 25vw, 50vw',
                loading: 'lazy',
                alt: tile_alt
            }}
          {%- endif -%}
        </div>

        {%- if tile_title != blank -%}
          <span class="shopx-category-tiles__title">{{ tile_title }}</span>
        {%- endif -%}

        {%- if tile_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "ShopX category tiles",
  "tag": "section",
  "class": "shopx-category-tiles-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title colour",
      "default": "#202020"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Image, title and link come from the collection unless you set them below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ShopX category tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
