{{ 'shopx-countdown-banner.css' | asset_url | stylesheet_tag }}

<div
  class="shopx-countdown-banner"
  style="
    --shopx-countdown-banner-background: {{ section.settings.background_color }};
    --shopx-countdown-banner-text-color: {{ section.settings.text_color }};
    --shopx-countdown-banner-padding-top: {{ section.settings.padding_top }}px;
    --shopx-countdown-banner-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="shopx-countdown-banner__inner">
    <div class="shopx-countdown-banner__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="shopx-countdown-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="shopx-countdown-banner__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {% render 'shopx-countdown',
      end: section.settings.countdown_end,
      class_name: 'shopx-countdown-banner',
      days_label: section.settings.days_label,
      hours_label: section.settings.hours_label,
      minutes_label: section.settings.minutes_label,
      seconds_label: section.settings.seconds_label
    %}
  </div>
</div>

{% schema %}
{
  "name": "ShopX countdown banner",
  "tag": "section",
  "class": "shopx-countdown-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Countdown end date and time",
      "info": "Leave empty for no countdown. Example: 2026-12-31T23:59:00+05:00"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Minutes label",
      "default": "Minutes"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Seconds label",
      "default": "Seconds"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fcf2e4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#202020"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "ShopX countdown banner"
    }
  ]
}
{% endschema %}
