{{ 'shopx-promo-banner.css' | asset_url | stylesheet_tag }}

{%- assign button_link = section.settings.button_link | default: routes.all_products_collection_url -%}

<div
  class="shopx-promo-banner"
  style="
    --shopx-promo-banner-background: {{ section.settings.background_color }};
    --shopx-promo-banner-heading-color: {{ section.settings.heading_color }};
    --shopx-promo-banner-text-color: {{ section.settings.text_color }};
    --shopx-promo-banner-button-background: {{ section.settings.button_background_color }};
    --shopx-promo-banner-button-text: {{ section.settings.button_text_color }};
    --shopx-promo-banner-padding-top: {{ section.settings.padding_top }}px;
    --shopx-promo-banner-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="shopx-promo-banner__inner">
    <div class="shopx-promo-banner__media">
      {%- if section.settings.image != blank -%}
        {%- assign image_alt = section.settings.image.alt | default: section.settings.heading -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'shopx-promo-banner__image',
            widths: '375, 600, 900, 1200, 1800',
            sizes: '(min-width: 750px) 600px, 100vw',
            loading: 'lazy',
            alt: image_alt
        }}
      {%- endif -%}
    </div>

    <div class="shopx-promo-banner__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="shopx-promo-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="shopx-promo-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="shopx-promo-banner__button" href="{{ button_link }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ShopX promo banner",
  "tag": "section",
  "class": "shopx-promo-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty links go to all products."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f4f2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#392915"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ShopX promo banner"
    }
  ]
}
{% endschema %}
