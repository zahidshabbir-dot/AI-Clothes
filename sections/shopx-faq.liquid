{{ 'shopx-faq.css' | asset_url | stylesheet_tag }}

<div
  class="shopx-faq"
  style="
    --shopx-faq-background: {{ section.settings.background_color }};
    --shopx-faq-heading-color: {{ section.settings.heading_color }};
    --shopx-faq-text-color: {{ section.settings.text_color }};
    --shopx-faq-line-color: {{ section.settings.line_color }};
    --shopx-faq-padding-top: {{ section.settings.padding_top }}px;
    --shopx-faq-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="shopx-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="shopx-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank -%}
        <details
          class="shopx-faq__item"
          {% if forloop.first and section.settings.open_first %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="shopx-faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="shopx-faq__toggle" aria-hidden="true"></span>
          </summary>
          {%- if block.settings.answer != blank -%}
            <div class="shopx-faq__answer">{{ block.settings.answer }}</div>
          {%- endif -%}
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ShopX FAQ",
  "tag": "section",
  "class": "shopx-faq-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider colour",
      "default": "#e2e2e2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ShopX FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
