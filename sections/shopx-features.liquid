{{ 'shopx-features.css' | asset_url | stylesheet_tag }}

<div
  class="shopx-features"
  style="
    --shopx-features-background: {{ section.settings.background_color }};
    --shopx-features-title-color: {{ section.settings.title_color }};
    --shopx-features-text-color: {{ section.settings.text_color }};
    --shopx-features-padding-top: {{ section.settings.padding_top }}px;
    --shopx-features-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <ul class="shopx-features__list page-width" role="list">
    {%- for block in section.blocks -%}
      <li class="shopx-features__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          {%- assign icon_alt = block.settings.icon.alt | default: '' -%}
          {{
            block.settings.icon
            | image_url: width: 120
            | image_tag:
              class: 'shopx-features__icon',
              width: 40,
              height: 40,
              loading: 'lazy',
              alt: icon_alt
          }}
        {%- endif -%}

        {%- if block.settings.title != blank -%}
          <p class="shopx-features__title">{{ block.settings.title }}</p>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <p class="shopx-features__text">{{ block.settings.text }}</p>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "ShopX features",
  "tag": "section",
  "class": "shopx-features-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title colour",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Leave empty for no icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ShopX features",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
