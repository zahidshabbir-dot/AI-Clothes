{%- doc -%}
  Arrow icon.

  @param {string} [direction] - 'left' or 'right'. Defaults to right.
  @param {string} [class] - Extra CSS class for the svg.
{%- enddoc -%}
<svg
  class="shopx-icon-arrow{% if direction == 'left' %} shopx-icon-arrow--left{% endif %} {{ class }}"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 10h12" />
  <path d="m11 5 5 5-5 5" />
</svg>
